# Copia este archivo a .env y rellena los valores que terminan en =.
# No pongas aquí la clave privada de OCI ni la publiques.

OCI_REGION=mx-monterrey-1
OCI_PROFILE=DEFAULT
# OCI_CONFIG_FILE=/home/USUARIO/.oci/config

# OCID del compartimento donde se creará la instancia.
OCI_COMPARTMENT_ID=

# Recomendado: OCID de una subred pública existente.
# Si se deja vacío, el script intentará detectar una única subred pública.
OCI_SUBNET_ID=
# Opcional si quieres limitar la detección a una VCN concreta.
OCI_VCN_ID=

# Recomendado dejar vacío para detectar la imagen Oracle Linux ARM más reciente.
# También puedes pegar aquí un OCID concreto obtenido con --discover.
OCI_IMAGE_ID=
OCI_IMAGE_OS=Oracle Linux
OCI_IMAGE_OS_VERSION=
OCI_IMAGE_NAME_REGEX=

OCI_SHAPE=VM.Standard.A1.Flex
OCI_OCPUS=2
OCI_MEMORY_GBS=12
OCI_BOOT_VOLUME_GBS=50
OCI_INSTANCE_NAME=a1-free-monterrey
OCI_ASSIGN_PUBLIC_IP=true

# Ruta absoluta a tu clave pública SSH. Si se omite, busca id_ed25519.pub o id_rsa.pub.
OCI_SSH_PUBLIC_KEY_PATH=/home/USUARIO/.ssh/id_ed25519.pub
# Alternativa: pegar el contenido de la clave pública directamente.
# OCI_SSH_PUBLIC_KEY=ssh-ed25519 AAAA...

# El capacity report reduce intentos inútiles y, si está disponible, revela el
# fault domain con capacidad. Si tu tenancy no lo permite, el script hace fallback.
OCI_CAPACITY_REPORT=true
OCI_DIRECT_FALLBACK_EVERY=10
OCI_INTERVAL_SECONDS=60
OCI_JITTER_SECONDS=15
OCI_CREATE_RETRIES=3
OCI_CREATE_RETRY_DELAY=10
OCI_INSTANCE_WAIT_SECONDS=300
# 0 = sin límite; un valor >0 sirve para una prueba controlada.
OCI_MAX_ATTEMPTS=0

# Solo se usan si el capacity report no está disponible.
# OCI_FALLBACK_FAULT_DOMAINS=FAULT-DOMAIN-1,FAULT-DOMAIN-2,FAULT-DOMAIN-3
# OCI_AVAILABILITY_DOMAIN=

OCI_STATE_FILE=/var/lib/oci-a1-claimer/instance.json
OCI_LOCK_FILE=/var/lib/oci-a1-claimer/instance.lock
OCI_LOG_LEVEL=INFO

# Opcional: notificación al terminar.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OCI_SSH_USER=opc
