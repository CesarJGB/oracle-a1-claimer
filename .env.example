# Copia este archivo a .env y rellena los valores que terminan en =.
# No pongas aquí la clave privada de OCI ni la publiques.

OCI_REGION=mx-monterrey-1
OCI_PROFILE=DEFAULT
# OCI_CONFIG_FILE=/home/USUARIO/.oci/config

# OCID del compartimento donde se creará la instancia.
OCI_COMPARTMENT_ID=

# Recomendado: OCID de una subred pública existente.
# Si se deja vacío, el script intentará detectar una única subred pública.
OCI_SUBNET_ID=
# Opcional si quieres limitar la detección a una VCN concreta.
OCI_VCN_ID=

# Recomendado dejar vacío para detectar la imagen Oracle Linux ARM más reciente.
# También puedes pegar aquí un OCID concreto obtenido con --discover.
OCI_IMAGE_ID=
OCI_IMAGE_OS=Oracle Linux
OCI_IMAGE_OS_VERSION=
OCI_IMAGE_NAME_REGEX=

OCI_SHAPE=VM.Standard.A1.Flex
OCI_OCPUS=2
OCI_MEMORY_GBS=12
OCI_BOOT_VOLUME_GBS=50
OCI_INSTANCE_NAME=a1-free-monterrey
OCI_ASSIGN_PUBLIC_IP=true

# Ruta absoluta a tu clave pública SSH. Si se omite, busca id_ed25519.pub o id_rsa.pub.
OCI_SSH_PUBLIC_KEY_PATH=/home/USUARIO/.ssh/id_ed25519.pub
# Alternativa: pegar el contenido de la clave pública directamente.
# OCI_SSH_PUBLIC_KEY=ssh-ed25519 AAAA...

# Modo de fault domain en intentos directos: 'auto' (permite que OCI elija
# automáticamente el fault domain) o 'rotate' (rotación secuencial FD1->FD2->FD3).
OCI_DIRECT_FAULT_DOMAIN_MODE=auto

# El capacity report reduce intentos inútiles y, si está disponible, revela el
# fault domain con capacidad. Si tu tenancy no lo permite, se desactiva solo
# durante esa ejecución y el fallback continúa espaciado.
OCI_CAPACITY_REPORT=true
# TTL en segundos para hints descubiertos por el capacity report (default: 180).
# Hints más viejos son descartados para no lanzar contra observaciones obsoletas.
OCI_CAPACITY_CANDIDATE_TTL_SECONDS=180
# Intervalo de comprobaciones del capacity report (no es el intervalo de
# solicitudes reales de creación).
OCI_INTERVAL_SECONDS=60
OCI_JITTER_SECONDS=15
# Ritmo directo adaptativo: ajusta gradualmente el intervalo entre intentos
# directos sin 429, y reduce el ritmo con backoff ante HTTP 429.
OCI_ADAPTIVE_DIRECT_INTERVAL=true
OCI_ADAPTIVE_MIN_INTERVAL_SECONDS=120
OCI_ADAPTIVE_MAX_INTERVAL_SECONDS=600
# Intentos directos cuando no hay capacidad reportada: intervalo base/inicial
# (240±30 s da unas 15 solicitudes reales por hora en promedio).
OCI_DIRECT_ATTEMPT_INTERVAL_SECONDS=240
OCI_DIRECT_ATTEMPT_JITTER_SECONDS=30
# Nunca se envían dos launch_instance con menos de este intervalo.
OCI_MIN_LAUNCH_GAP_SECONDS=60
# existing_instance se consulta al iniciar, periódicamente con esta frecuencia
# y tras un error ambiguo. No se repite innecesariamente si la comprobación es fresca.
OCI_EXISTING_CHECK_INTERVAL_SECONDS=900
# Se conserva por compatibilidad con instalaciones anteriores; ya no cuenta
# ciclos ni activa una ráfaga de candidatos.
# OCI_DIRECT_FALLBACK_EVERY=10
OCI_CREATE_RETRIES=3
OCI_CREATE_RETRY_DELAY=10
OCI_INSTANCE_WAIT_SECONDS=300
# 0 = sin límite; un valor >0 sirve para una prueba controlada.
OCI_MAX_ATTEMPTS=0

# Solo se usan si direct_fault_domain_mode=rotate o si se fija un AD concreto.
# OCI_FALLBACK_FAULT_DOMAINS=FAULT-DOMAIN-1,FAULT-DOMAIN-2,FAULT-DOMAIN-3
# OCI_AVAILABILITY_DOMAIN=

OCI_STATE_FILE=/var/lib/oci-a1-claimer/instance.json
OCI_RUNTIME_FILE=/var/lib/oci-a1-claimer/runtime.json
OCI_LOCK_FILE=/var/lib/oci-a1-claimer/instance.lock
OCI_LOG_LEVEL=INFO

# Opcional: notificación al terminar.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OCI_SSH_USER=opc
